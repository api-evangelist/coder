{
  "opencollection": "1.0.0",
  "info": {
    "name": "Coder Agents InitScript API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Coder-Session-Token",
      "value": "{{Coder-Session-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "InitScript",
        "type": "folder"
      },
      "items": [
        {
          "info": {
