                "description": "Operating system"
              },
              {
                "name": "arch",
                "value": "",
                "type": "path",
                "description": "Architecture"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Coder-Session-Token",
              "value": "{{Coder-Session-Token}}",
              "placement": "header"
            }
          },
          "docs": "Get agent init script"
        }
      ]
    }
  ],
  "bundled": true
