{
  "opencollection": "1.0.0",
  "info": {
    "name": "Coder Agents Prebuilds API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Coder-Session-Token",
      "value": "{{Coder-Session-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Prebuilds",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get prebuilds settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{coderHost}/api/v2/api/v2/prebuilds/settings",
            "auth": {
              "type": "apikey",
              "key": "Coder-Session-Token",
              "value": "{{Coder-Session-Token}}",
              "placement": "header"
            }
          },
          "docs": "Get prebuilds settings"
        },
        {
          "info": {
            "name": "Update prebuilds settings",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{coderHost}/api/v2/api/v2/prebuilds/settings",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Coder-Session-Token",
              "value": "{{Coder-Session-Token}}",
              "placement": "header"
            }
          },
          "docs": "Update prebuilds settings"
        }
      ]
    }
  ],
  "bundled": true
}